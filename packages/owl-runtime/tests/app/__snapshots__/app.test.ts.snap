exports[`app > can add functions to the bdom 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { __globals__ } = helpers;
  const hdlr_fn1 = (ctx)=>__globals__.plop('click');
  
  let block1 = createBlock(\`<div class="my-div" block-handler-0="click"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    return b1;
  }
}"
`;

exports[`app > can call processTask twice in a row without crashing 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, component, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`parent\`);
    const c2 = component(this, ctx, node, \`Child\`, () => ({}));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

