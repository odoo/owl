// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`app > app: clear scheduler tasks on destroy 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, component, toggle, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`A\`);
    const c3 = toggle(() => (ctx['this'].state.value) ? 0 : -1, [() => {
    const c2 = component(this, ctx, node, \`B\`, () => ({}));
    return c2;
  }]);
    const c4 = multi([c1, c3]);
    return c4;
  }
}"
`;

