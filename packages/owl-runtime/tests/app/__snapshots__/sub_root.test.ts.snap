// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`destroy a subroot while another component is mounted in main app 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle } = helpers;
  
  return function template(ctx, node) {
    const c3 = toggle(() => (ctx['this'].state.flag) ? 0 : 1, [() => {
    const c1 = component(this, ctx, node, \`ChildB\`, () => ({}));
    return c1;
  }, () => {
    const c2 = component(this, ctx, node, \`ChildA\`, () => ({}));
    return c2;
  }]);
    return c3;
  }
}"
`;

exports[`destroy a subroot while another component is mounted in main app 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, createRef, multi } = helpers;
  
  let block1 = createBlock(\`<div block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const c1 = text(\`a\`);
    const b1 = block1();
    b1.ref(0, createRef(ctx['this'].ref, node));
    const c2 = multi([c1, b1]);
    return c2;
  }
}"
`;

