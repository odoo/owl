exports[`subroot > can mount subroot 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<div>main app</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    return b1;
  }
}"
`;

