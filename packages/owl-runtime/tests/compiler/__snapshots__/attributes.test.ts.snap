exports[`attributes > from object variables set previously 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><span block-attribute-0="class"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`o\`, true, () => ({a:'b'}));
    renderEffect(() => {
      b1.set(0, ctx1['o'].a);
    });
    return b1;
  }
}"
`;

