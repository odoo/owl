// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`comments > comments are ignored 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<div>hello owl</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    return b1;
  }
}"
`;

exports[`comments > only a comment 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`\`);
    return c1;
  }
}"
`;

exports[`comments > properly handle comments between t-if/t-else 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>true</span>\`);
  let block3 = createBlock(\`<span>owl</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (true) ? 0 : 1, [() => {
    const b2 = block2();
    return b2;
  }, () => {
    const b3 = block3();
    return b3;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;
