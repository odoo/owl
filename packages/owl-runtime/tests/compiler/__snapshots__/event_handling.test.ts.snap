  let { list } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['activate'](ctx['action']);
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  let block2 = createBlock(\`<li><a block-handler-0="click">link</a></li>\`);
  
