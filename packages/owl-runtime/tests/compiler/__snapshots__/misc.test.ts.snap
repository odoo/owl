// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`misc > complex template 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, toggle, component, list, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div block-attribute-0="class"><div block-attribute-1="class"><div class="batch_header"><a block-attribute-2="href" block-attribute-3="class" title="View Batch"><block-child-0/><block-child-1/><i class="arrow fa fa-window-maximize"/></a></div><block-child-2/><div class="batch_slots"><block-child-3/><block-child-4/></div><div class="batch_commits"><block-child-5/></div></div></div>\`);
  let block2 = createBlock(\`<i class="fa fa-exclamation-triangle"/>\`);
  let block3 = createBlock(\`<span><i class="fa fa-cog fa-spin fa-fw"/> preparing</span>\`);
  let block4 = createBlock(\`<div class="slot_filler"/>\`);
  let block5 = createBlock(\`<div class="one_line"><a block-attribute-0="href" block-attribute-1="class"><block-child-0/><block-child-1/><block-child-2/><block-child-3/><block-child-4/></a><a block-attribute-2="href" class="badge badge-light" title="View Commit on Github"><i class="fa fa-github"/></a><span><block-child-5/></span></div>\`);
  let block6 = createBlock(\`<i class="fa fa-fw fa-hashtag" title="This commit is a new head"/>\`);
  let block7 = createBlock(\`<i class="fa fa-fw fa-link" title="This commit is an existing head from bundle branches"/>\`);
  let block8 = createBlock(\`<i class="fa fa-fw fa-code-fork" title="This commit is matched from a base batch with matching merge_base"/>\`);
  let block9 = createBlock(\`<i class="fa fa-fw fa-clock-o" title="This commit is the head of a base branch"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['batch'].formated_age));
    b1.insert(0, c1);
    const c2 = toggle(() => (ctx['batch'].has_warning) ? 0 : -1, [() => {
    const b2 = block2();
    return b2;
  }]);
    b1.insert(1, c2);
    const c3 = toggle(() => (ctx['batch'].state=='preparing') ? 0 : -1, [() => {
    const b3 = block3();
    return b3;
  }]);
    b1.insert(2, c3);
    const c5 = list(() => (ctx['batch'].slot_ids.filter(_slot=>_slot.build_id.id&&!_slot.trigger_id.manual&&(ctx['options'].trigger_display[_slot.trigger_id.id]))), ctx, \`slot\`, (ctx1) => (ctx1['slot'].id), 15, (ctx1) => {
    const c4 = component(this, ctx1, node, \`SlotButton\`, () => ({class: ctx1['slot_container'], slot: ctx1['slot']}));
    return c4;
  }, false);
    b1.insert(3, c5);
    const c6 = list(() => ([1,2,3,4]), ctx, \`x\`, (ctx2) => (ctx2['x']), 15, (ctx2) => {
    const b4 = block4();
    return b4;
  }, false);
    b1.insert(4, c6);
    const c13 = list(() => (ctx['commit_links']), ctx, \`commit_link\`, (ctx3) => (ctx3['commit_link'].id), 15, (ctx3) => {
    const b5 = block5();
    const c7 = toggle(() => (ctx3['commit_link'].match_type=='new') ? 0 : -1, [() => {
      const b6 = block6();
      return b6;
    }]);
    b5.insert(0, c7);
    const c8 = toggle(() => (ctx3['commit_link'].match_type=='head') ? 0 : -1, [() => {
      const b7 = block7();
      return b7;
    }]);
    b5.insert(1, c8);
    const c9 = toggle(() => (ctx3['commit_link'].match_type=='base_match') ? 0 : -1, [() => {
      const b8 = block8();
      return b8;
    }]);
    b5.insert(2, c9);
    const c10 = toggle(() => (ctx3['commit_link'].match_type=='base_head') ? 0 : -1, [() => {
      const b9 = block9();
      return b9;
    }]);
    b5.insert(3, c10);
    const c11 = out(() => (ctx3['commit_link'].commit_dname));
    b5.insert(4, c11);
    const c12 = out(() => (ctx3['commit_link'].commit_subject));
    b5.insert(5, c12);
    renderEffect(() => {
      b5.set(0, \`/runbot/commit/\${ctx3['commit_link'].commit_id}\`);
      b5.set(1, \`badge badge-light batch_commit match_type_\${ctx3['commit_link'].match_type}\`);
      b5.set(2, 'https://%s/commit/%s'%(ctx3['commit_link'].commit_remote_url,ctx3['commit_link'].commit_name));
    });
    return b5;
  }, false);
    b1.insert(5, c13);
    renderEffect(() => {
      b1.set(0, \`batch_tile \${ctx['options'].more?'more':'nomore'}\`);
      b1.set(1, \`card bg-\${ctx['klass']}-light\`);
      b1.set(2, \`/runbot/batch/\${ctx['batch'].id}\`);
      b1.set(3, \`badge badge-\${ctx['batch'].has_warning?'warning':'light'}\`);
    });
    return b1;
  }
}"
`;

exports[`misc > global 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, callCtx, callTemplate, tset, multi, list } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c8 = list(() => ([4,5,6]), ctx, \`value\`, (ctx1) => (ctx1['value']), 0, (ctx1) => {
    const b2 = block2();
    const c1 = out(() => (ctx1['value']));
    b2.insert(0, c1);
    const ctx4 = callCtx(ctx1, {}, () => {
      const ctx2 = callCtx(ctx1, {foo: () => ('aaa')}, null);
      const c2 = callTemplate(\`_callee-uses-foo\`, this, app, ctx2, node);
      const c3 = callTemplate(\`_callee-uses-foo\`, this, app, ctx1, node);
      const ctx3 = tset(ctx1, \`foo\`, true, () => ('bbb'));
      const c4 = callTemplate(\`_callee-uses-foo\`, this, app, ctx3, node);
      const c5 = multi([c2, c3, c4]);
      return c5;
    });
    const c6 = callTemplate(\`_callee-asc\`, this, app, ctx4, node);
    const c7 = multi([b2, c6]);
    return c7;
  }, false);
    b1.insert(0, c8);
    const c9 = callTemplate(\`_callee-asc-toto\`, this, app, ctx, node);
    b1.insert(1, c9);
    return b1;
  }
}"
`;

exports[`misc > global 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callZero, renderEffect } = helpers;
  
  let block1 = createBlock(\`<año block-attribute-0="falló"><block-child-0/></año>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callZero(ctx);
    b1.insert(0, c1);
    renderEffect(() => {
      b1.set(0, 'agüero');
    });
    return b1;
  }
}"
`;

exports[`misc > global 3`] = `
"function anonymous(app, bdom, helpers
) {
