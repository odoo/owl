exports[`misc > other complex template 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, callHandler, list, renderEffect, multi, toggle, createRef, callTemplate, component } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['selectProject'](ctx['project']), ctx, ev);
  const hdlr_fn2 = (ctx, ev) => callHandler(ctx['toggleSettingsMenu'], ctx, ev);
  const hdlr_fn3 = (ctx, ev) => callHandler(ctx['toggleMore'], ctx, ev);
  const hdlr_fn4 = (ctx, ev) => callHandler(ctx['updateFilter'], ctx, ev);
  const hdlr_fn5 = (ctx, ev) => callHandler(ctx['updateFilter'], ctx, ev);
  const hdlr_fn6 = (ctx, ev) => callHandler(ctx['clearSearch'], ctx, ev);
  const hdlr_fn7 = (ctx, ev) => callHandler(ctx['updateTriggerDisplay'], ctx, ev);
  const hdlr_fn8 = (ctx, ev) => callHandler(ctx['triggerAll'], ctx, ev);
  const hdlr_fn9 = (ctx, ev) => callHandler(ctx['triggerNone'], ctx, ev);
  const hdlr_fn10 = (ctx, ev) => callHandler(ctx['triggerDefault'], ctx, ev);
  const hdlr_fn11 = (ctx, ev) => callHandler(ctx['toggleSettingsMenu'], ctx, ev);
  
  let block1 = createBlock(\`<div><header><nav class="navbar navbar-expand-md navbar-light bg-light"><a block-attribute-0="href"><b style="color:#777;"><block-child-0/></b></a><button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#top_menu_collapse"><span class="navbar-toggler-icon"/></button><div class="collapse navbar-collapse" id="top_menu_collapse" aria-expanded="false"><ul class="nav navbar-nav ml-auto text-right" id="top_menu"><block-child-1/><li class="nav-item divider"/><block-child-2/></ul><div><div class="input-group input-group-sm"><div class="input-group-prepend input-group-sm"><button class="btn btn-default fa fa-cog" title="Settings" block-handler-1="click"/><button class="btn btn-default" block-handler-2="click"> More </button><block-child-3/></div><input class="form-control" type="text" placeholder="Search" aria-label="Search" name="search" block-property-3="value" block-handler-4="keyup" block-handler-5="change" block-ref="6"/><div class="input-group-append"><button class="btn btn-default fa fa-eraser" block-handler-7="click"/></div></div></div></div></nav></header><div class="container-fluid" block-ref="8"><div class="row"><div class="form-group col-md-6"><h5>Triggers</h5><block-child-4/></div></div></div><div class="container-fluid frontend"><div class="row"><div class="col-md-12"><block-child-5/></div><div class="col-md-12"><block-child-6/><block-child-7/></div></div></div></div>\`);
  let block2 = createBlock(\`<li class="nav-item"><a class="nav-link" href="#" block-handler-0="click"><block-child-0/></a></li>\`);
  let block3 = createBlock(\`<li class="nav-item dropdown"><b><a class="nav-link" block-attribute-0="href">Login</a></b></li>\`);
  let block4 = createBlock(\`<li class="nav-item"><a href="/runbot/errors" class="nav-link text-danger" block-attribute-0="title"><i class="fa fa-bug"/><block-child-0/></a></li>\`);
  let block5 = createBlock(\`<li class="nav-item divider"/>\`);
  let block6 = createBlock(\`<li class="nav-item"><a href="/runbot/errors" class="nav-link" title="Random Bugs"><i class="fa fa-bug"/></a></li>\`);
  let block7 = createBlock(\`<li class="nav-item divider"/>\`);
  let block8 = createBlock(\`<li class="nav-item dropdown"><a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><b><span><block-child-0/></span></b></a><div class="dropdown-menu js_usermenu" role="menu"><a class="dropdown-item" id="o_logout" role="menuitem" block-attribute-0="href">Logout</a><a class="dropdown-item" role="menuitem" block-attribute-1="href">Web</a></div></li>\`);
  let block9 = createBlock(\`<select class="custom-select" name="category" id="category"><block-child-0/></select>\`);
  let block10 = createBlock(\`<option block-attribute-0="value" block-property-1="selected"><block-child-0/></option>\`);
  let block11 = createBlock(\`<div class="form-check"><input class="form-check-input" type="checkbox" block-attribute-0="name" block-attribute-1="id" block-property-2="checked" block-attribute-3="data-trigger_id" block-handler-4="change"/><label class="form-check-label" block-attribute-5="for"><block-child-0/></label></div>\`);
  let block12 = createBlock(\`<div><button class="btn btn-sm btn-default" block-handler-0="click">All</button><button class="btn btn-sm btn-default" block-handler-1="click">None</button><button class="btn btn-sm btn-info" block-handler-2="click">Default</button><button class="btn btn-sm btn-default" block-handler-3="click">Close</button></div>\`);
  let block13 = createBlock(\`<div class="alert alert-warning" role="alert"><block-child-0/> </div>\`);
  let block14 = createBlock(\`<div class="mb32"><h1>No project</h1></div>\`);
  let block15 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['project'].name));
    b1.insert(0, c1);
    const c3 = list(() => (ctx['projects']), ctx, \`project\`, (ctx1) => (ctx1['project'].id), 15, (ctx1) => {
    const b2 = block2();
    b2.set(0, [hdlr_fn1, ctx1]);
    const c2 = out(() => (ctx1['project'].name));
    b2.insert(0, c2);
    return b2;
  }, false);
    b1.insert(1, c3);
    const c11 = toggle(() => (ctx['user']) ? 0 : -1, [() => {
    const c10 = toggle(() => (ctx['user'].public) ? 0 : 1, [() => {
      const b3 = block3();
      renderEffect(() => {
        b3.set(0, \`/web/login?redirect=/\`);
      });
      return b3;
    }, () => {
      const c7 = toggle(() => (ctx['nb_assigned_errors']&&ctx['nb_assigned_errors']>0) ? 0 : (ctx['nb_build_errors']&&ctx['nb_build_errors']>0) ? 1 : -1, [() => {
        const b4 = block4();
        const c4 = out(() => (ctx['nb_assigned_errors']));
        b4.insert(0, c4);
        renderEffect(() => {
          b4.set(0, \`You have \${ctx['nb_assigned_errors']} random bug assigned\`);
        });
        const b5 = block5();
        const c5 = multi([b4, b5]);
        return c5;
      }, () => {
        const b6 = block6();
        const b7 = block7();
        const c6 = multi([b6, b7]);
        return c6;
      }]);
      const b8 = block8();
      const c8 = out(() => (ctx['user'].name.length>25?ctx['user'].namesubstring(0,23)+'...':ctx['user'].name));
      b8.insert(0, c8);
      renderEffect(() => {
        b8.set(0, \`/web/session/logout?redirect=/\`);
        b8.set(1, \`/web\`);
      });
      const c9 = multi([c7, b8]);
      return c9;
    }]);
    return c10;
  }]);
    b1.insert(2, c11);
    b1.set(1, [hdlr_fn2, ctx]);
    b1.set(2, [hdlr_fn3, ctx]);
    const c14 = toggle(() => (ctx['categories']&&ctx['categories'].length>1) ? 0 : -1, [() => {
    const b9 = block9();
    const c13 = list(() => (ctx['categories']), ctx, \`category\`, (ctx2) => (ctx2['category'].id), 15, (ctx2) => {
      const b10 = block10();
      const c12 = out(() => (ctx2['category'].name));
      b10.insert(0, c12);
      renderEffect(() => {
        b10.set(0, ctx2['category'].id);
        b10.set(1, new Boolean(ctx2['category'].id==ctx2['options'].active_category_id));
      });
      return b10;
    }, false);
    b9.insert(0, c13);
    return b9;
  }]);
    b1.insert(3, c14);
    b1.set(4, [hdlr_fn4, ctx]);
    b1.set(5, [hdlr_fn5, ctx]);
    b1.ref(6, createRef(ctx['search_input'], node));
    b1.set(7, [hdlr_fn6, ctx]);
    b1.ref(8, createRef(ctx['settings_menu'], node));
    const c19 = toggle(() => (ctx['triggers']) ? 0 : -1, [() => {
    const c17 = list(() => (ctx['triggers']), ctx, \`trigger\`, (ctx3) => (ctx3['trigger'].id), 15, (ctx3) => {
      const c16 = toggle(() => (!ctx3['trigger'].manual&&ctx3['trigger'].project_id===ctx3['project'].id&&ctx3['trigger'].category_id===ctx3['options'].active_category_id) ? 0 : -1, [() => {
        const b11 = block11();
        b11.set(4, [hdlr_fn7, ctx3]);
        const c15 = out(() => (ctx3['trigger'].name));
        b11.insert(0, c15);
        renderEffect(() => {
          b11.set(0, \`trigger_\${ctx3['trigger'].id}\`);
          b11.set(1, \`trigger_\${ctx3['trigger'].id}\`);
          b11.set(2, new Boolean(ctx3['options'].trigger_display[ctx3['trigger'].id]));
          b11.set(3, ctx3['trigger'].id);
          b11.set(5, \`trigger_\${ctx3['trigger'].id}\`);
        });
        return b11;
      }]);
      return c16;
    }, false);
    const b12 = block12();
    b12.set(0, [hdlr_fn8, ctx]);
    b12.set(1, [hdlr_fn9, ctx]);
    b12.set(2, [hdlr_fn10, ctx]);
    b12.set(3, [hdlr_fn11, ctx]);
    const c18 = multi([c17, b12]);
    return c18;
  }]);
    b1.insert(4, c19);
    const c21 = toggle(() => (ctx['load_infos']) ? 0 : -1, [() => {
    const c20 = callTemplate(\`LOAD_INFOS_TEMPLATE\`, this, app, ctx, node);
    return c20;
  }]);
    b1.insert(5, c21);
    const c23 = toggle(() => (ctx['message']) ? 0 : -1, [() => {
    const b13 = block13();
    const c22 = out(() => (ctx['message']));
    b13.insert(0, c22);
    return b13;
  }]);
    b1.insert(6, c23);
    const c26 = toggle(() => (!ctx['project']) ? 0 : 1, [() => {
    const b14 = block14();
    return b14;
  }, () => {
    const b15 = block15();
    const c24 = component(this, ctx, node, \`BundlesList\`, () => ({bundles: ctx['bundles'].sticky, category_custom_views: ctx['category_custom_views'], search: ctx['search']}));
    b15.insert(0, c24);
    const c25 = component(this, ctx, node, \`BundlesList\`, () => ({bundles: ctx['bundles'].dev, search: ctx['search']}));
    b15.insert(1, c25);
    return b15;
  }]);
    b1.insert(7, c26);
    renderEffect(() => {
      b1.set(0, \`/runbot/\${ctx['project'].slug}\`);
      b1.set(3, new String((ctx['search'].value) === 0 ? 0 : ((ctx['search'].value) || "")));
    });
    return b1;
  }
}"
`;
