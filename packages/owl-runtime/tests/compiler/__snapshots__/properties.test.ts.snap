// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`changing an attribute with t-att- 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { renderEffect } = helpers;
  
  let block1 = createBlock(\`<div block-attribute-0="value"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    renderEffect(() => {
      b1.set(0, ctx['v']);
    });
    return b1;
  }
}"
`;

exports[`dynamic input value: falsy values 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { renderEffect } = helpers;
  
  let block1 = createBlock(\`<input block-property-0="value"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    renderEffect(() => {
      b1.set(0, new String((0) === 0 ? 0 : ((0) || "")));
    });
    return b1;
  }
}"
`;

