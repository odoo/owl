exports[`simple templates, mostly static > template with multiple t tag with multiple content 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/>Loading<block-child-2/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['a']));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['b']));
    b1.insert(1, c2);
    const c3 = out(() => (ctx['c']));
    b1.insert(2, c3);
    return b1;
  }
}"
`;

exports[`simple templates, mostly static > template with t tag with multiple content 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, toggle } = helpers;
  
  let block1 = createBlock(\`<div>Loading<block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (false) ? 0 : -1, [() => {
    const c1 = text(\`\`);
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

