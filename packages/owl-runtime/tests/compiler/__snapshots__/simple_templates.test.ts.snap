exports[`simple templates, mostly static > inline template string with content in t-out 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, out } = helpers;
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`v\`, true, () => (1));
    const c1 = out(() => (\`text\${ctx1['v']}\`));
    return c1;
  }
}"
`;

