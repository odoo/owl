exports[`simple templates, mostly static > two t-outs next to each other, in a div 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['text1']));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['text2']));
    b1.insert(1, c2);
    return b1;
  }
}"
`;
