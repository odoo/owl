exports[`simple templates, mostly static > static text and dynamic text (no t tag) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, out, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`hello \`);
    const c2 = out(() => (ctx['text']));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

