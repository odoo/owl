exports[`simple templates, mostly static > two t-outs next to each other 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = out(() => (ctx['text1']));
    const c2 = out(() => (ctx['text2']));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

