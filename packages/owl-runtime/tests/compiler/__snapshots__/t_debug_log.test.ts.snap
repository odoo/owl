// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`debugging > t-debug 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>hey</span>\`);
  
  return function template(ctx, node) {
    debugger;
    const b1 = block1();
    const c1 = toggle(() => (true) ? 0 : -1, [() => {
    debugger;
    const b2 = block2();
    return b2;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`debugging > t-debug on sub template 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<p>coucou</p>\`);
  
  return function template(ctx, node) {
    debugger;
    const b1 = block1();
    return b1;
  }
}"
`;

exports[`debugging > t-debug on sub template 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callTemplate } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callTemplate(\`sub\`, this, app, ctx, node);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`debugging > t-debug: interaction with t-set 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, out, multi } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    debugger;
    const ctx1 = tset(ctx, \`foo\`, true, () => (42));
    const c1 = text("");
    debugger;
    const ctx2 = tset(ctx1, \`bar\`, true, () => (49));
    const c2 = text("");
    const b1 = block1();
    const c3 = out(() => (ctx2['foo']+ctx2['bar']));
    b1.insert(0, c3);
    const c4 = multi([c1, c2, b1]);
    return c4;
  }
}"
`;

exports[`debugging > t-log 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset } = helpers;
  
  let block1 = createBlock(\`<div/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`foo\`, true, () => (42));
    console.log(ctx1['foo']+3);
    return b1;
  }
}"
`;

exports[`debugging > t-log: interaction with t-set 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, out, multi } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    console.log(ctx['foo']);
    const ctx1 = tset(ctx, \`foo\`, true, () => (42));
    const c1 = text("");
    console.log(ctx1['bar']);
    const ctx2 = tset(ctx1, \`bar\`, true, () => (49));
    const c2 = text("");
    const b1 = block1();
    const c3 = out(() => (ctx2['foo']+ctx2['bar']));
    b1.insert(0, c3);
    const c4 = multi([c1, c2, b1]);
    return c4;
  }
}"
`;
