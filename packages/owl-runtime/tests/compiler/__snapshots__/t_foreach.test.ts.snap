exports[`t-foreach > t-call with body in t-foreach in t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callCtx, callTemplate, list, out, multi } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><span>[<block-child-1/>][<block-child-2/>][<block-child-3/>]</span></div>\`);
  let block2 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c5 = list(() => (ctx['numbers']), ctx, \`a\`, (ctx1) => (ctx1['a']), 0, (ctx1) => {
    const c2 = list(() => (ctx1['letters']), ctx1, \`b\`, (ctx2) => (ctx2['b']), 0, (ctx2) => {
      const ctx3 = callCtx(ctx2, {c: () => ('x'+'_'+ctx2['a']+'_'+ctx2['b'])}, null);
      const c1 = callTemplate(\`sub\`, this, app, ctx3, node);
      return c1;
    }, false);
    const b2 = block2();
    const c3 = out(() => (ctx1['c']));
    b2.insert(0, c3);
    const c4 = multi([c2, b2]);
    return c4;
  }, false);
    b1.insert(0, c5);
    const c6 = out(() => (ctx['a']));
    b1.insert(1, c6);
    const c7 = out(() => (ctx['b']));
    b1.insert(2, c7);
    const c8 = out(() => (ctx['c']));
    b1.insert(3, c8);
    return b1;
  }
}"
`;

