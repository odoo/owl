exports[`t-foreach with loops and multiple t-set 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, out, multi, list } = helpers;
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`a\`, true, () => (0));
    const c14 = list(() => ([1,2]), ctx1, \`i\`, (ctx2) => (ctx2['i']), 15, (ctx2) => {
    const ctx3 = tset(ctx2, \`a\`, true, () => (ctx2['a']+10));
    const ctx4 = tset(ctx3, \`b\`, true, () => (0));
    const c7 = list(() => ([1,2]), ctx4, \`j\`, (ctx5) => (ctx5['j']), 15, (ctx5) => {
      const ctx6 = tset(ctx5, \`a\`, true, () => (ctx5['a']+1));
      const ctx7 = tset(ctx6, \`b\`, true, () => (ctx6['b']+1));
      const c1 = text(\` |InnerLoop:\`);
      const c2 = out(() => (ctx7['a']));
      const c3 = text(\`,\`);
      const c4 = out(() => (ctx7['b']));
      const c5 = text(\`| \`);
      const c6 = multi([c1, c2, c3, c4, c5]);
      return c6;
    }, false);
    const c8 = text(\` |OuterLoop:\`);
    const c9 = out(() => (ctx4['a']));
    const c10 = text(\`,\`);
    const c11 = out(() => (ctx4['b']));
    const c12 = text(\`| \`);
    const c13 = multi([c7, c8, c9, c10, c11, c12]);
    return c13;
  }, false);
    const c15 = text(\` After:\`);
    const c16 = out(() => (ctx1['a']));
    const c17 = text(\`,\`);
    const c18 = out(() => (ctx1['b']));
    const c19 = multi([c14, c15, c16, c17, c18]);
    return c19;
  }
}"
`;
