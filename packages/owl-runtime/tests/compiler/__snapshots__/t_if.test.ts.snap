exports[`t-if > two t-ifs next to each other 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, toggle, multi } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<span><block-child-0/></span>\`);
  let block3 = createBlock(\`<p>1</p>\`);
  let block4 = createBlock(\`<p>2</p>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b2 = block2();
    const c1 = out(() => (ctx['text']));
    b2.insert(0, c1);
    return b2;
  }]);
    b1.insert(0, c2);
    const c4 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b3 = block3();
    const b4 = block4();
    const c3 = multi([b3, b4]);
    return c3;
  }]);
    b1.insert(1, c4);
    return b1;
  }
}"
`;
