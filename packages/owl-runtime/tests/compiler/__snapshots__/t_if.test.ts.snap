// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-if > a t-if next to a div 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, toggle, multi } = helpers;
  
  let block1 = createBlock(\`<div>foo</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['cond']) ? 0 : -1, [() => {
    const c1 = text(\`1\`);
    return c1;
  }]);
    const c3 = multi([b1, c2]);
    return c3;
  }
}"
`;

exports[`t-if > a t-if with two inner nodes 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { multi, toggle } = helpers;
  
  let block1 = createBlock(\`<span>yip</span>\`);
  let block2 = createBlock(\`<div>yip</div>\`);
  
  return function template(ctx, node) {
    const c2 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b1 = block1();
    const b2 = block2();
    const c1 = multi([b1, b2]);
    return c1;
  }]);
    return c2;
  }
}"
`;

exports[`t-if > boolean value condition elif (no outside node) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, toggle } = helpers;
  
  return function template(ctx, node) {
    const c5 = toggle(() => (ctx['color']=='black') ? 0 : (ctx['color']=='yellow') ? 1 : (ctx['color']=='red') ? 2 : 3, [() => {
    const c1 = text(\`black pearl\`);
    return c1;
  }, () => {
    const c2 = text(\`yellow submarine\`);
    return c2;
  }, () => {
    const c3 = text(\`red is dead\`);
    return c3;
  }, () => {
    const c4 = text(\`beer\`);
    return c4;
  }]);
    return c5;
  }
}"
`;

