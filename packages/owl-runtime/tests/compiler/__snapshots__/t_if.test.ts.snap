exports[`t-if > can use some boolean operators in expressions 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/><block-child-2/><block-child-3/><block-child-4/><block-child-5/><block-child-6/><block-child-7/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['cond1']&&ctx['cond2']) ? 0 : -1, [() => {
    const c1 = text(\`and\`);
    return c1;
  }]);
    b1.insert(0, c2);
    const c4 = toggle(() => (ctx['cond1']&&ctx['cond3']) ? 0 : -1, [() => {
    const c3 = text(\`nope\`);
    return c3;
  }]);
    b1.insert(1, c4);
    const c6 = toggle(() => (ctx['cond1']||ctx['cond3']) ? 0 : -1, [() => {
    const c5 = text(\`or\`);
    return c5;
  }]);
    b1.insert(2, c6);
    const c8 = toggle(() => (ctx['cond3']||ctx['cond4']) ? 0 : -1, [() => {
    const c7 = text(\`nope\`);
    return c7;
  }]);
    b1.insert(3, c8);
    const c10 = toggle(() => (ctx['m']>3) ? 0 : -1, [() => {
    const c9 = text(\`mgt\`);
    return c9;
  }]);
    b1.insert(4, c10);
    const c12 = toggle(() => (ctx['n']>3) ? 0 : -1, [() => {
    const c11 = text(\`ngt\`);
    return c11;
  }]);
    b1.insert(5, c12);
    const c14 = toggle(() => (ctx['m']<3) ? 0 : -1, [() => {
    const c13 = text(\`mlt\`);
    return c13;
  }]);
    b1.insert(6, c14);
    const c16 = toggle(() => (ctx['n']<3) ? 0 : -1, [() => {
    const c15 = text(\`nlt\`);
    return c15;
  }]);
    b1.insert(7, c16);
    return b1;
  }
}"
`;

exports[`t-if > div containing a t-if with two inner nodes 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { multi, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>yip</span>\`);
  let block3 = createBlock(\`<div>yip</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b2 = block2();
    const b3 = block3();
    const c1 = multi([b2, b3]);
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`t-if > dynamic content after t-if with two children nodes 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { multi, toggle, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<p>1</p>\`);
  let block3 = createBlock(\`<p>2</p>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b2 = block2();
    const b3 = block3();
    const c1 = multi([b2, b3]);
    return c1;
  }]);
    b1.insert(0, c2);
    const c3 = out(() => (ctx['text']));
    b1.insert(1, c3);
    return b1;
  }
}"
`;

