exports[`t-if > t-set, then t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, out, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`title\`, true, () => ('test'));
    const c2 = toggle(() => (ctx1['title']) ? 0 : -1, [() => {
    const c1 = out(() => (ctx1['title']));
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`t-if > t-set, then t-if, part 2 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>COUCOU</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`y\`, true, () => (true));
    const ctx2 = tset(ctx1, \`x\`, true, () => (ctx1['y']));
    const c1 = toggle(() => (ctx2['x']) ? 0 : -1, [() => {
    const b2 = block2();
    return b2;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-if > t-set, then t-if, part 3 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>AAA</span>\`);
  let block3 = createBlock(\`<span>BBB</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`y\`, true, () => (false));
    const ctx2 = tset(ctx1, \`x\`, true, () => (ctx1['y']));
    const c1 = toggle(() => (ctx2['x']) ? 0 : (!ctx2['x']) ? 1 : -1, [() => {
    const b2 = block2();
    return b2;
  }, () => {
    const b3 = block3();
    return b3;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

