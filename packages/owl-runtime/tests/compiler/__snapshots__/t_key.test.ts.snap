exports[`t-key > can use t-key directive on a node as a function 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const c2 = keyed(() => (ctx['getKey'](ctx['beer'])), () => {
    const b1 = block1();
    const c1 = out(() => (ctx['beer'].name));
    b1.insert(0, c1);
    return b1;
  });
    return c2;
  }
}"
`;

exports[`t-key > t-key directive in a list 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, list } = helpers;
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  let block2 = createBlock(\`<li><block-child-0/></li>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = list(() => (ctx['beers']), ctx, \`beer\`, (ctx1) => (ctx1['beer'].id), 15, (ctx1) => {
    const b2 = block2();
    const c1 = out(() => (ctx1['beer'].name));
    b2.insert(0, c1);
    return b2;
  }, false);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`t-key > t-key on sub dom node pushes a child block in its parent 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { toggle, keyed } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<span/>\`);
  let block3 = createBlock(\`<div><h1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (ctx['hasSpan']) ? 0 : -1, [() => {
    const b2 = block2();
    return b2;
  }]);
    b1.insert(0, c1);
    const c2 = keyed(() => (ctx['key']), () => {
    const b3 = block3();
    return b3;
  });
    b1.insert(1, c2);
    return b1;
  }
}"
`;

exports[`t-key > t-key on sub dom node pushes a child block in its parent 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed } = helpers;
  
  let block1 = createBlock(\`<div><h1/></div>\`);
  
  return function template(ctx, node) {
    const c1 = keyed(() => (ctx['key']), () => {
    const b1 = block1();
    return b1;
  });
    return c1;
  }
}"
`;

exports[`t-key > t-key: interaction with t-out 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, out } = helpers;
  
  let block1 = createBlock(\`<p><block-child-0/></p>\`);
  
  return function template(ctx, node) {
    const c2 = keyed(() => (ctx['key']), () => {
    const b1 = block1();
    const c1 = out(() => (ctx['text']));
    b1.insert(0, c1);
    return b1;
  });
    return c2;
  }
}"
`;
