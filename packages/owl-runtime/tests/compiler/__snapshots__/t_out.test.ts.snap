exports[`t-out > t-out on a node with a body, as a default 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, text } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = out(() => (ctx['var']), () => {
    const c1 = text(\`nope\`);
    return c1;
  });
    b1.insert(0, c2);
    return b1;
  }
}"
`;

