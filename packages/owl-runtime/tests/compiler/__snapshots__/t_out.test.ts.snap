exports[`t-out > t-out bdom 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, tset, out } = helpers;
  
  let block1 = createBlock(\`<div><span><block-child-0/></span></div>\`);
  let block2 = createBlock(\`<ol>set</ol>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const lazy1 = lazy(() => {
    const b2 = block2();
    return b2;
  });
    const ctx1 = tset(ctx, \`var\`, false, lazy1);
    const c1 = out(() => (ctx1['var']));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

