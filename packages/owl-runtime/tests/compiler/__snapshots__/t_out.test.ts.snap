exports[`t-out > t-out switch markup on bdom 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, tset, out, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<ol>set</ol>\`);
  let block3 = createBlock(\`<span><block-child-0/></span>\`);
  let block4 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const lazy1 = lazy(() => {
    const b2 = block2();
    return b2;
  });
    const ctx1 = tset(ctx, \`bdom\`, false, lazy1);
    const c3 = toggle(() => (ctx1['hasBdom']) ? 0 : 1, [() => {
    const b3 = block3();
    const c1 = out(() => (ctx1['bdom']));
    b3.insert(0, c1);
    return b3;
  }, () => {
    const b4 = block4();
    const c2 = out(() => (ctx1['var']));
    b4.insert(0, c2);
    return b4;
  }]);
    b1.insert(0, c3);
    return b1;
  }
}"
`;

