exports[`t-out > multiple calls to t-out 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callCtx, callTemplate } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>coucou</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = callCtx(ctx, {}, () => {
    const b2 = block2();
    return b2;
  });
    const c1 = callTemplate(\`sub\`, this, app, ctx1, node);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-out > multiple calls to t-out 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callZero } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><div>Greeter</div><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callZero(ctx);
    b1.insert(0, c1);
    const c2 = callZero(ctx);
    b1.insert(1, c2);
    return b1;
  }
}"
`;

