// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-ref > can get a ref on a node 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef } = helpers;
  
  let block1 = createBlock(\`<div><span block-ref="0"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.ref(0, createRef(ctx['myspan'], node));
    return b1;
  }
}"
`;

exports[`t-ref > ref in a t-call 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callTemplate } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callTemplate(\`sub\`, this, app, ctx, node);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-ref > ref in a t-call 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef } = helpers;
  
  let block1 = createBlock(\`<div>1<span block-ref="0"/>2</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.ref(0, createRef(ctx['name'], node));
    return b1;
  }
}"
`;

exports[`t-ref > ref in a t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b2 = block2();
    b2.ref(0, createRef(ctx['name'], node));
    return b2;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-ref > refs in a loop 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, createRef, out, list } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<div block-ref="0"><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c3 = list(() => (ctx['items']), ctx, \`item\`, (ctx1) => (ctx1['item'].id), 15, (ctx1) => {
    const c2 = keyed(() => (ctx1['item'].id), () => {
      const b2 = block2();
      b2.ref(0, createRef(ctx1['item'].ref, node));
      const c1 = out(() => (ctx1['item'].id));
      b2.insert(0, c1);
      return b2;
    });
    return c2;
  }, false);
    b1.insert(0, c3);
    return b1;
  }
}"
`;

exports[`t-ref > two refs, one in a t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><p block-ref="0"/></div>\`);
  let block2 = createBlock(\`<span block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (ctx['condition']) ? 0 : -1, [() => {
    const b2 = block2();
    b2.ref(0, createRef(ctx['refs'].name, node));
    return b2;
  }]);
    b1.insert(0, c1);
    b1.ref(0, createRef(ctx['refs'].p, node));
    return b1;
  }
}"
`;
