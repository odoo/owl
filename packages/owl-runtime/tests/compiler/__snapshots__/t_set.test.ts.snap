exports[`t-set > value priority (with non text body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, withDefault, tset, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<span>2</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const lazy1 = lazy(() => {
    const b2 = block2();
    return b2;
  });
    const ctx1 = tset(ctx, \`value\`, true, () => (withDefault(1, lazy1)));
    const c1 = out(() => (ctx1['value']));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-set > value priority 1`] = `
