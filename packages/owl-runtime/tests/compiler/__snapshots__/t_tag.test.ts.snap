exports[`qweb t-tag > with multiple t-tag in same template 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed } = helpers;
  
  let block1 = tag => createBlock(\`<\${tag || 't'}><block-child-0/></\${tag || 't'}>\`);
  let block2 = tag => createBlock(\`<\${tag || 't'}>baz</\${tag || 't'}>\`);
  
  return function template(ctx, node) {
    const c2 = keyed(() => (ctx['outer']), (tag) => {
    const b1 = block1(tag)();
    const c1 = keyed(() => (ctx['inner']), (tag) => {
      const b2 = block2(tag)();
      return b2;
    });
    b1.insert(0, c1);
    return b1;
  });
    return c2;
  }
}"
`;

exports[`qweb t-tag > with multiple t-tag in same template, part 2 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, multi } = helpers;
  
  let block1 = tag => createBlock(\`<\${tag || 't'}>bar</\${tag || 't'}>\`);
  let block2 = tag => createBlock(\`<\${tag || 't'}>baz</\${tag || 't'}>\`);
  
  return function template(ctx, node) {
    const c1 = keyed(() => (ctx['brother']), (tag) => {
    const b1 = block1(tag)();
    return b1;
  });
    const c2 = keyed(() => (ctx['brother']), (tag) => {
    const b2 = block2(tag)();
    return b2;
  });
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;
