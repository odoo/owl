exports[`loading templates > can load a few templates from a xml string 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callTemplate } = helpers;
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callTemplate(\`items\`, this, app, ctx, node);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`loading templates > can load a few templates from a xml string 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { multi } = helpers;
  
  let block1 = createBlock(\`<li>ok</li>\`);
  let block2 = createBlock(\`<li>foo</li>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const b2 = block2();
    const c1 = multi([b1, b2]);
    return c1;
  }
}"
`;

