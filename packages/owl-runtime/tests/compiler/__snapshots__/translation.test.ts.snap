// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`translation context > body of t-sets are translated in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, out, multi } = helpers;
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`label\`, false, \`traduit\`);
    const c1 = text("");
    const c2 = out(() => (ctx1['label']));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

exports[`translation context > default slot params and content translated in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, callSlot } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = callSlot(ctx, node, 'default', {param: () => (\`param\`), title: () => (\`título\`)}, null, () => {
    const c1 = text(\` foo \`);
    return c1;
  });
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`translation context > props with modifier .translate are translated in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`ChildComponent\`, () => ({text: \`jeu\`}));
    return c1;
  }
}"
`;

exports[`translation context > props with modifier .translate are translated in context 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.text));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`translation context > slot attrs and text contents are translated in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, makeSlots, component } = helpers;
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'a': {__render: (ctx1, node) => {
    const c1 = text(\`jeu\`);
    return c1;
  }, __ctx: ctx, __attrs: {title: () => (\`título\`)}}});
    const c2 = component(this, ctx, node, \`ChildComponent\`, () => ({slots: slots1}));
    return c2;
  }
}"
`;

exports[`translation context > slot attrs and text contents are translated in context 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callSlot } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = callSlot(ctx, node, 'a', null, null, null);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`translation context > t-translation-context with several children 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, toggle } = helpers;
  
  let block1 = createBlock(\`<div><div/><div/><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (true) ? 0 : -1, [() => {
    const c1 = text(\`\`);
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`translation context > translation of attributes in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<div title="titre" label="game"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    return b1;
  }
}"
`;

exports[`translation context > translation of text in context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { multi } = helpers;
  
  let block1 = createBlock(\`<div>word</div>\`);
  let block2 = createBlock(\`<div>mot</div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const b2 = block2();
    const c1 = multi([b1, b2]);
    return c1;
  }
}"
`;

