exports[`translation support > body of t-sets with html content are translated 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, tset, out } = helpers;
  
  let block1 = createBlock(\`<div>translated</div>\`);
  
  return function template(ctx, node) {
    const lazy1 = lazy(() => {
    const b1 = block1();
    return b1;
  });
    const ctx1 = tset(ctx, \`label\`, false, lazy1);
    const c1 = out(() => (ctx1['label']));
    return c1;
  }
}"
`;

exports[`translation support > body of t-sets with text and html content are translated 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, text, multi, tset, out } = helpers;
  
  let block1 = createBlock(\`<div>translated</div>\`);
  
  return function template(ctx, node) {
    const lazy1 = lazy(() => {
    const c1 = text(\` translated \`);
    const b1 = block1();
    const c2 = multi([c1, b1]);
    return c2;
  });
    const ctx1 = tset(ctx, \`label\`, false, lazy1);
    const c3 = out(() => (ctx1['label']));
    return c3;
  }
}"
`;

