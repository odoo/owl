exports[`translation support > t-set and falsy t-value: t-body are translated 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { withDefault, tset, out } = helpers;
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`label\`, true, () => (withDefault(false, \`translated\`)));
    const c1 = out(() => (ctx1['label']));
    return c1;
  }
}"
`;

