exports[`event handling > handler receive the event as argument 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callHandler, component, out } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].inc, ctx, ev);
  
  let block1 = createBlock(\`<span block-handler-0="click"><block-child-0/><block-child-1/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    const c1 = component(this, ctx, node, \`Child\`, () => ({}));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['this'].state.value));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

