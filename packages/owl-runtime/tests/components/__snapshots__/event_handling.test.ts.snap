exports[`event handling > objects from scope are properly captured by t-on 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { list } = helpers;
  const hdlr_fn1 = (ctx,_ev)=>ctx['this'].onClick(ctx['item'].val,_ev);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<div class="item" block-handler-0="click"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = list(() => (ctx['this'].items), ctx, \`item\`, (ctx1) => (ctx1['item']), 15, (ctx1) => {
    const b2 = block2();
    b2.set(0, [hdlr_fn1, ctx1]);
    return b2;
  }, false);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`event handling > support for callable expression in event handler 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].obj.onInput, ctx, ev);
  
  let block1 = createBlock(\`<div><block-child-0/><input type="text" block-handler-0="input"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].state.value));
    b1.insert(0, c1);
    b1.set(0, [hdlr_fn1, ctx]);
    return b1;
  }
}"
`;

exports[`event handling > t-on with handler bound to dynamic argument on a t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { list } = helpers;
  const hdlr_fn1 = (ctx,_ev)=>ctx['this'].onClick(ctx['item'],_ev);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<div class="item" block-handler-0="click"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = list(() => (ctx['this'].items), ctx, \`item\`, (ctx1) => (ctx1['item']), 15, (ctx1) => {
    const b2 = block2();
    b2.set(0, [hdlr_fn1, ctx1]);
    return b2;
  }, false);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`event handling > unnamed slot should call the event only once 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { makeSlots, component, catcher, callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].inc, ctx, ev);
  
  let block1 = createBlock(\`<div class="named"/>\`);
  let block2 = createBlock(\`<div class="default unnamed"/>\`);
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'named': {__render: (ctx1, node) => {
    const b1 = block1();
    return b1;
  }, __ctx: ctx}, 'default': {__render: (ctx2, node) => {
    const b2 = block2();
    return b2;
  }, __ctx: ctx}});
    const c1 = component(this, ctx, node, \`Child\`, () => ({slots: slots1}));
    const c2 = catcher(c1, {'click': [hdlr_fn1, ctx]});
    return c2;
  }
}"
`;

exports[`event handling > unnamed slot should call the event only once 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callSlot, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = callSlot(ctx, node, 'named', null, null, null);
    const c2 = callSlot(ctx, node, 'default', null, null, null);
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;
