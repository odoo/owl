// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`basics > basic use 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`Child\`, () => ({p: 1}));
    return c1;
  }
}"
`;

exports[`basics > basic use 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<span>child<block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.p));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`basics > can select a sub widget  1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle, multi } = helpers;
  
  return function template(ctx, node) {
    const c2 = toggle(() => (ctx['this'].state.options.flag) ? 0 : -1, [() => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({}));
    return c1;
  }]);
    const c4 = toggle(() => (!ctx['this'].state.options.flag) ? 0 : -1, [() => {
    const c3 = component(this, ctx, node, \`OtherChild\`, () => ({}));
    return c3;
  }]);
    const c5 = multi([c2, c4]);
    return c5;
  }
}"
`;

