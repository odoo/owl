exports[`basics > sub widget is interactive 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`Child\`, () => ({p: 1}));
    return c1;
  }
}"
`;

exports[`basics > sub widget is interactive 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callHandler, out } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].inc, ctx, ev);
  
  let block1 = createBlock(\`<span><button block-handler-0="click">click</button>child<block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    const c1 = out(() => (ctx['this'].state.val));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

