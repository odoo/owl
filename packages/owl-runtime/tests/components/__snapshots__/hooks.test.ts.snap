exports[`hooks > useListener ignores the event that created its component 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle, multi } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['this'].show.set(true);
  
  let block1 = createBlock(\`<button block-handler-0="click">open</button>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    const c2 = toggle(() => (ctx['this'].show()) ? 0 : -1, [() => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({}));
    return c1;
  }]);
    const c3 = multi([b1, c2]);
    return c3;
  }
}"
`;

