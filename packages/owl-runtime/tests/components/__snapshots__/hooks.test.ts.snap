exports[`hooks > useEffect hook > effect can depend on stuff in dom 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, toggle } = helpers;
  
  let block1 = createBlock(\`<div block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const c1 = toggle(() => (ctx['this'].state.value) ? 0 : -1, [() => {
    const b1 = block1();
    b1.ref(0, createRef(ctx['this'].ref, node));
    return b1;
  }]);
    return c1;
  }
}"
`;

