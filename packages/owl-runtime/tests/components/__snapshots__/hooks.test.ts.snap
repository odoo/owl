exports[`hooks > useListener work with references 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, out } = helpers;
  
  let block1 = createBlock(\`<span block-ref="0"><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.ref(0, createRef(ctx['this'].span, node));
    const c1 = out(() => (ctx['this'].value()));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

