// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hooks > can use onWillStart, onWillUpdateProps 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`MyComponent\`, () => ({value: ctx['this'].state.value}));
    return c1;
  }
}"
`;

exports[`hooks > can use onWillStart, onWillUpdateProps 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.value));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

