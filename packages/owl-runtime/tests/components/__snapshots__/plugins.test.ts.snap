exports[`components can give config to plugins 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, text, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = out(() => (ctx['this'].a.inputA));
    const c2 = text(\`-\`);
    const c3 = out(() => (ctx['this'].b.inputB));
    const c4 = multi([c1, c2, c3]);
    return c4;
  }
}"
`;

exports[`components can register resources 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, component, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`1 | \`);
    const c2 = component(this, ctx, node, \`Level2\`, () => ({}));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

