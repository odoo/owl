// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a global plugin can import the current app 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`coucou\`);
    return c1;
  }
}"
`;

exports[`basic use (setup) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  return function template(ctx, node) {
    const c1 = out(() => (ctx['this'].a.value));
    return c1;
  }
}"
`;

