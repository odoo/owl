// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`basics > can be mixed with useProps() 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = component(this, ctx, node, \`Child\`, () => ({main: 7, extra: 'side'}));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`basics > can be mixed with useProps() 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/>/<block-child-1/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].all.extra));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['this'].main));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

