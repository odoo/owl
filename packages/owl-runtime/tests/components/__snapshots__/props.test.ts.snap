    const c1 = component(this, ctx1, node, \`Todo\`, () => ({todo: ctx1['elem'], toggle: ()=>ctx1['this'].toggle(ctx1['elem'].id)}));
    return c1;
  }, false);
    return c2;
  }
}"
`;

