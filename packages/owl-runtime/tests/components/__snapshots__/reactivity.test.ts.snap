exports[`reactivity in lifecycle > child re-renders when shared atom changes while parent has an in-flight fiber 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, text, out, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`Child\`, () => ({bv: ctx['this'].b()}));
    const c2 = text(\`parent:a=\`);
    const c3 = out(() => (ctx['this'].a()));
    const c4 = text(\`:b=\`);
    const c5 = out(() => (ctx['this'].b()));
    const c6 = multi([c1, c2, c3, c4, c5]);
    return c6;
  }
}"
`;

