// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`components and computed > Child is not rerender when reactive is computed 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, component, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = out(() => (ctx['this'].c()));
    const c2 = component(this, ctx, node, \`Child\`, () => ({}));
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

