exports[`computed with equals in components > a recompute with a shallow-equal result does not re-render 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, list } = helpers;
  
  let block1 = createBlock(\`<ul><block-child-0/><block-child-1/></ul>\`);
  let block2 = createBlock(\`<li><block-child-0/></li>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].track()));
    b1.insert(0, c1);
    const c3 = list(() => (ctx['this'].visible()), ctx, \`todo\`, (ctx1) => (ctx1['todo'].id), 15, (ctx1) => {
    const b2 = block2();
    const c2 = out(() => (ctx1['todo'].text));
    b2.insert(0, c2);
    return b2;
  }, false);
    b1.insert(1, c3);
    return b1;
  }
}"
`;

exports[`reactive cleanup on component destruction > benchmark-like scenario: signal.Array rows with computed isSelected 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, list } = helpers;
  
  let block1 = createBlock(\`<table><tbody><block-child-0/></tbody></table>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = list(() => (ctx['this'].rows()), ctx, \`row\`, (ctx1) => (ctx1['row'].id), 15, (ctx1) => {
    const c1 = component(this, ctx1, node, \`TableRow\`, () => ({row: ctx1['row'], selected: ctx1['this'].selectedId}));
    return c1;
  }, false);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`reactive cleanup on component destruction > benchmark-like scenario: signal.Array rows with computed isSelected 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, renderEffect } = helpers;
  
  let block1 = createBlock(\`<tr block-attribute-0="class"><td><block-child-0/></td><td><a><block-child-1/></a></td></tr>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].p.row.id));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['this'].p.row.label()));
    b1.insert(1, c2);
    renderEffect(() => {
      b1.set(0, ctx['this'].isSelected()?'danger':'');
    });
    return b1;
  }
}"
`;

exports[`reactive cleanup on component destruction > destroying a component with computed cleans up signal observers 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['this'].show()) ? 0 : -1, [() => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({selected: ctx['this'].selectedId}));
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

