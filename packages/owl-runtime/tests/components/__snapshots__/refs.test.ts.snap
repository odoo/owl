    const c1 = out(() => (ctx['this'].props.tree.value));
    b1.insert(0, c1);
    const c3 = toggle(() => (ctx['this'].props.tree.child) ? 0 : -1, [() => {
    const c2 = component(this, ctx, node, \`Test\`, () => ({tree: ctx['this'].props.tree.child}));
    return c2;
  }]);
    b1.insert(1, c3);
    return b1;
  }
}"
`;

exports[`refs > refs and t-key 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, createRef, multi } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['this'].state.renderId++;
  
  let block1 = createBlock(\`<button block-handler-0="click"/>\`);
  let block2 = createBlock(\`<p block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    const c1 = keyed(() => (ctx['this'].state.renderId), () => {
    const b2 = block2();
    b2.ref(0, createRef(ctx['this'].root, node));
    return b2;
  });
    const c2 = multi([b1, c1]);
    return c2;
  }
}"
`;

exports[`refs > refs are properly bound in slots 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, callHandler, createRef, makeSlots, component } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].doSomething, ctx, ev);
  
  let block1 = createBlock(\`<div><span class="counter"><block-child-0/></span><block-child-1/></div>\`);
  let block2 = createBlock(\`<button block-handler-0="click" block-ref="1">do something</button>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].state.val));
    b1.insert(0, c1);
    const slots1 = makeSlots({'footer': {__render: (ctx1, node) => {
    const b2 = block2();
    b2.set(0, [hdlr_fn1, ctx1]);
    b2.ref(1, createRef(ctx1['this'].button, node));
    return b2;
  }, __ctx: ctx}});
    const c2 = component(this, ctx, node, \`Dialog\`, () => ({slots: slots1}));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

