exports[`refs > ref in slot is unset across a t-if nested inside the slot content 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, toggle, makeSlots, component } = helpers;
  
  let block1 = createBlock(\`<span block-ref="0">hi</span>\`);
  
  return function template(ctx, node) {
    const c3 = toggle(() => (ctx['this'].visible()) ? 0 : -1, [() => {
    const slots1 = makeSlots({'default': {__render: (ctx1, node) => {
      const c1 = toggle(() => (ctx1['this'].inner()) ? 0 : -1, [() => {
        const b1 = block1();
        b1.ref(0, createRef(ctx1['this'].myRef, node));
        return b1;
      }]);
      return c1;
    }, __ctx: ctx}});
    const c2 = component(this, ctx, node, \`Wrapper\`, () => ({slots: slots1}));
    return c2;
  }]);
    return c3;
  }
}"
`;

