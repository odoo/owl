// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`refs > a listener firing during the removal still sees its ref 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<input block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (ctx['this'].show()) ? 0 : -1, [() => {
    const b2 = block2();
    b2.ref(0, createRef(ctx['this'].input, node));
    return b2;
  }]);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

