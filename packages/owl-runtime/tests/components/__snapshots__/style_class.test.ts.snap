exports[`style and class handling > class on sub component, which is switched to another 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle } = helpers;
  
  return function template(ctx, node) {
    const c3 = toggle(() => (ctx['this'].props.child==='a') ? 0 : 1, [() => {
    const c1 = component(this, ctx, node, \`ChildA\`, () => ({class: ctx['this'].props.class}));
    return c1;
  }, () => {
    const c2 = component(this, ctx, node, \`ChildB\`, () => ({class: ctx['this'].props.class}));
    return c2;
  }]);
    return c3;
  }
}"
`;

