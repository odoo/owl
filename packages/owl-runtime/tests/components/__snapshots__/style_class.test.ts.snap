exports[`style and class handling > can set class on multi root component 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`Child\`, () => ({class: 'fromparent'}));
    return c1;
  }
}"
`;

exports[`style and class handling > can set class on multi root component 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { renderEffect, multi } = helpers;
  
  let block1 = createBlock(\`<div>a</div>\`);
  let block2 = createBlock(\`<span block-attribute-0="class">b</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const b2 = block2();
    renderEffect(() => {
      b2.set(0, ctx['this'].props.class);
    });
    const c1 = multi([b1, b2]);
    return c1;
  }
}"
`;

