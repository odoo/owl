exports[`t-component > modifying a sub widget 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { dynamicComponent } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = dynamicComponent(this, ctx, node, () => (ctx['this'].Counter), () => ({}));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-component > modifying a sub widget 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['this'].state.counter++;
  
  let block1 = createBlock(\`<div><block-child-0/><button block-handler-0="click">Inc</button></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].state.counter));
    b1.insert(0, c1);
    b1.set(0, [hdlr_fn1, ctx]);
    return b1;
  }
}"
`;

