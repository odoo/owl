// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-component > can switch between dynamic components without the need for a t-key 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { dynamicComponent } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = dynamicComponent(this, ctx, node, () => (ctx['this'].constructor.components[ctx['this'].state.child]), () => ({}));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

