exports[`t-component > can use dynamic components (the class) if given (with different root tagname) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, dynamicComponent } = helpers;
  
  return function template(ctx, node) {
    const c2 = keyed(() => (ctx['this'].state.child), () => {
    const c1 = dynamicComponent(this, ctx, node, () => (ctx['this'].myComponent), () => ({}));
    return c1;
  });
    return c2;
  }
}"
`;

