exports[`list of components > reconciliation alg works for t-foreach in t-foreach, 2 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, list } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<p><block-child-0/></p>\`);
  let block3 = createBlock(\`<p><block-child-0/></p>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c3 = list(() => (ctx['this'].state.rows), ctx, \`row\`, (ctx1) => (ctx1['row']), 15, (ctx1) => {
    const b2 = block2();
    const c2 = list(() => (ctx1['this'].state.cols), ctx1, \`col\`, (ctx2) => (ctx2['col']), 15, (ctx2) => {
      const b3 = block3();
      const c1 = component(this, ctx2, node, \`Child\`, () => ({row: ctx2['row'], col: ctx2['col']}));
      b3.insert(0, c1);
      return b3;
    }, false);
    b2.insert(0, c2);
    return b2;
  }, false);
    b1.insert(0, c3);
    return b1;
  }
}"
`;

