// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`list of components > components in a node in a t-foreach  1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, list } = helpers;
  
  let block1 = createBlock(\`<div><ul><block-child-0/></ul></div>\`);
  let block2 = createBlock(\`<li><block-child-0/></li>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = list(() => (ctx['this'].items), ctx, \`item\`, (ctx1) => ('li_'+ctx1['item']), 15, (ctx1) => {
    const b2 = block2();
    const c1 = component(this, ctx1, node, \`Child\`, () => ({item: ctx1['item']}));
    b2.insert(0, c1);
    return b2;
  }, false);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

