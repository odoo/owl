exports[`list of components > order is correct when slots are not of same type 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { toggle, text, makeSlots, component } = helpers;
  
  let block1 = createBlock(\`<div>A</div>\`);
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'a': {__render: (ctx1, node) => {
    const c1 = toggle(() => (!ctx1['this'].state.active) ? 0 : -1, [() => {
      const b1 = block1();
      return b1;
    }]);
    return c1;
  }, __ctx: ctx, __attrs: {active: () => (!ctx['this'].state.active)}}, 'b': {__render: (ctx2, node) => {
    const c2 = text(\`B\`);
    return c2;
  }, __ctx: ctx, __attrs: {active: () => (true)}}, 'c': {__render: (ctx3, node) => {
    const c3 = text(\`C\`);
    return c3;
  }, __ctx: ctx, __attrs: {active: () => (ctx['this'].state.active)}}});
    const c4 = component(this, ctx, node, \`Child\`, () => ({slots: slots1}));
    return c4;
  }
}"
`;

exports[`list of components > order is correct when slots are not of same type 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callSlot, keyed, list } = helpers;
  
  return function template(ctx, node) {
    const c2 = list(() => (ctx['this'].slotNames), ctx, \`slotName\`, (ctx1) => (ctx1['slotName']), 0, (ctx1) => {
    const c1 = keyed(() => (ctx1['slotName']), (name) => callSlot(ctx1, node, name, null, null, null));
    return c1;
  }, false);
    return c2;
  }
}"
`;

exports[`list of components > reconciliation alg works for t-foreach in t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, list } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c3 = list(() => (ctx['this'].state.s), ctx, \`section\`, (ctx1) => (ctx1['section_index']), 11, (ctx1) => {
    const c2 = list(() => (ctx1['section'].blips), ctx1, \`blip\`, (ctx2) => (ctx2['blip_index']), 11, (ctx2) => {
      const c1 = component(this, ctx2, node, \`Child\`, () => ({blip: ctx2['blip']}));
      return c1;
    }, false);
    return c2;
  }, false);
    b1.insert(0, c3);
    return b1;
  }
}"
`;

