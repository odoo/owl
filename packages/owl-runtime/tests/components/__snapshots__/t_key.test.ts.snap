// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-key > t-foreach with t-key switch component position 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, component, list } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c3 = list(() => (ctx['this'].clist), ctx, \`c\`, (ctx1) => (ctx1['c']), 15, (ctx1) => {
    const c2 = keyed(() => (ctx1['this'].key1), () => {
      const c1 = component(this, ctx1, node, \`Child\`, () => ({key: ctx1['c']+ctx1['this'].key1}));
      return c1;
    });
    return c2;
  }, false);
    b1.insert(0, c3);
    return b1;
  }
}"
`;

exports[`t-key > t-foreach with t-key switch component position 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.key));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-key > t-key change on a component rendering an empty list 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, component, multi } = helpers;
  
  let block1 = createBlock(\`<button>b</button>\`);
  let block2 = createBlock(\`<span>end</span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = keyed(() => (ctx['this'].key), () => {
    const c1 = component(this, ctx, node, \`List\`, () => ({items: ctx['this'].items}));
    return c1;
  });
    const b2 = block2();
    const c3 = multi([b1, c2, b2]);
    return c3;
  }
}"
`;

exports[`t-key > t-key change on a component rendering an empty list 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, list } = helpers;
  
  return function template(ctx, node) {
    const c2 = list(() => (ctx['this'].props.items), ctx, \`item\`, (ctx1) => (ctx1['item_index']), 11, (ctx1) => {
    const c1 = out(() => (ctx1['item']));
    return c1;
  }, false);
    return c2;
  }
}"
`;

