exports[`t-key > t-key on multiple Components with t-call 2 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, component, multi } = helpers;
  
  return function template(ctx, node) {
    const c2 = keyed(() => (ctx['key1']), () => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({key: ctx['key1']}));
    return c1;
  });
    const c4 = keyed(() => (ctx['key2']), () => {
    const c3 = component(this, ctx, node, \`Child\`, () => ({key: ctx['key2']}));
    return c3;
  });
    const c5 = multi([c2, c4]);
    return c5;
  }
}"
`;

