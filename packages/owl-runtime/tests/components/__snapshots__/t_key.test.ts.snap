exports[`t-key > t-key on multiple Components with t-call 1 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callCtx, callTemplate } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/><block-child-1/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = callCtx(ctx, {key: () => (ctx['this'].key1)}, null);
    const c1 = callTemplate(\`calledTemplate\`, this, app, ctx1, node);
    b1.insert(0, c1);
    const ctx2 = callCtx(ctx, {key: () => (ctx['this'].key2)}, null);
    const c2 = callTemplate(\`calledTemplate\`, this, app, ctx2, node);
    b1.insert(1, c2);
    return b1;
  }
}"
`;

