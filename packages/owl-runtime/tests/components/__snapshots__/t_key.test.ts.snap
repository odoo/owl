exports[`t-key > t-key on multiple Components 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { keyed, component } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/><block-child-1/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = keyed(() => (ctx['this'].key1), () => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({key: ctx['this'].key1}));
    return c1;
  });
    b1.insert(0, c2);
    const c4 = keyed(() => (ctx['this'].key2), () => {
    const c3 = component(this, ctx, node, \`Child\`, () => ({key: ctx['this'].key2}));
    return c3;
  });
    b1.insert(1, c4);
    return b1;
  }
}"
`;

