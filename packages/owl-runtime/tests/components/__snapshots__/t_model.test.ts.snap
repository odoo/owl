// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-model directive > .lazy modifier 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, out, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><input block-property-0="value" block-handler-1="change"/><span><block-child-0/></span></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].text).set(ev.target.value); }, ctx]);
    const c1 = out(() => (ctx['this'].text()));
    b1.insert(0, c1);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx['this'].text)());
    });
    return b1;
  }
}"
`;

