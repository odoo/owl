exports[`t-model directive > t-model on select with static options 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, out, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><select block-property-0="value" block-handler-1="change"><option value="a"><block-child-0/></option><option value="b"><block-child-1/></option><option value="c"><block-child-2/></option></select></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].model).set(ev.target.value); }, ctx]);
    const c1 = out(() => ('a'));
    b1.insert(0, c1);
    const c2 = out(() => ('b'));
    b1.insert(1, c2);
    const c3 = out(() => ('c'));
    b1.insert(2, c3);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx['this'].model)());
    });
    return b1;
  }
}"
`;

exports[`t-model directive > t-model with dynamic number values on select options in foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, out, renderEffect, list } = helpers;
  
  let block1 = createBlock(\`<select block-handler-0="change"><block-child-0/></select>\`);
  let block2 = createBlock(\`<option block-attribute-0="value" block-attribute-1="selected"><block-child-0/></option>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [(_ctx, ev) => { modelExpr(ctx['this'].value).set(toNumber(ev.target.value)); }, ctx]);
    const c2 = list(() => (ctx['this'].options), ctx, \`o\`, (ctx1) => (ctx1['o'].value), 15, (ctx1) => {
    const b2 = block2();
    const c1 = out(() => (ctx1['o'].value));
    b2.insert(0, c1);
    renderEffect(() => {
      b2.set(0, ctx1['o'].value);
      b2.set(1, modelExpr(ctx['this'].value)() === ctx1['o'].value);
    });
    return b2;
  }, false);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

