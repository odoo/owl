exports[`t-model directive > on an input, type=checkbox 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, text, toggle, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><input type="checkbox" block-property-0="checked" block-handler-1="input"/><span><block-child-0/></span></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].flag).set(ev.target.checked); }, ctx]);
    const c3 = toggle(() => (ctx['this'].flag()) ? 0 : 1, [() => {
    const c1 = text(\`yes\`);
    return c1;
  }, () => {
    const c2 = text(\`no\`);
    return c2;
  }]);
    b1.insert(0, c3);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx['this'].flag)());
    });
    return b1;
  }
}"
`;

