exports[`t-model directive > t-model with dynamic values on select options 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, out, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><select block-handler-0="change"><option block-attribute-1="value" block-attribute-2="selected"><block-child-0/></option><option block-attribute-3="value" block-attribute-4="selected"><block-child-1/></option></select></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [(_ctx, ev) => { modelExpr(ctx['this'].model).set(ev.target.value); }, ctx]);
    const c1 = out(() => (ctx['this'].options[0]));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['this'].options[1]));
    b1.insert(1, c2);
    renderEffect(() => {
      b1.set(1, ctx['this'].options[0]);
      b1.set(2, modelExpr(ctx['this'].model)() === ctx['this'].options[0]);
      b1.set(3, ctx['this'].options[1]);
      b1.set(4, modelExpr(ctx['this'].model)() === ctx['this'].options[1]);
    });
    return b1;
  }
}"
`;

