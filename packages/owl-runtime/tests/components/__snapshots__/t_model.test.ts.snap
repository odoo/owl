exports[`t-model directive > can also define t-on directive on same event, part 1 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, callHandler, renderEffect } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].onInput, ctx, ev);
  
  let block1 = createBlock(\`<div><input block-property-0="value" block-handler-1="input" block-handler-2="input"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].text).set(ev.target.value); }, ctx]);
    b1.set(2, [hdlr_fn1, ctx]);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx['this'].text)());
    });
    return b1;
  }
}"
`;

exports[`t-model directive > can also define t-on directive on same event, part 2 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, callHandler, renderEffect } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].onClick, ctx, ev);
  const hdlr_fn2 = (ctx, ev) => callHandler(ctx['this'].onClick, ctx, ev);
  const hdlr_fn3 = (ctx, ev) => callHandler(ctx['this'].onClick, ctx, ev);
  
  let block1 = createBlock(\`<div><input type="radio" id="one" value="One" block-property-0="checked" block-handler-1="click" block-handler-2="click"/><input type="radio" id="two" value="Two" block-property-3="checked" block-handler-4="click" block-handler-5="click"/><input type="radio" id="three" value="Three" block-property-6="checked" block-handler-7="click" block-handler-8="click"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].choice).set(ev.target.value); }, ctx]);
    b1.set(2, [hdlr_fn1, ctx]);
    b1.set(4, [(_ctx, ev) => { modelExpr(ctx['this'].choice).set(ev.target.value); }, ctx]);
    b1.set(5, [hdlr_fn2, ctx]);
    b1.set(7, [(_ctx, ev) => { modelExpr(ctx['this'].choice).set(ev.target.value); }, ctx]);
    b1.set(8, [hdlr_fn3, ctx]);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx['this'].choice)() === 'One');
      b1.set(3, modelExpr(ctx['this'].choice)() === 'Two');
      b1.set(6, modelExpr(ctx['this'].choice)() === 'Three');
    });
    return b1;
  }
}"
`;

exports[`t-model directive > following a scope protecting directive (e.g. t-set) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, modelExpr, toNumber, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><input block-property-0="value" block-handler-1="input"/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`admiral\`, true, () => ('Bruno'));
    b1.set(1, [(_ctx, ev) => { modelExpr(ctx1['this'].text).set(ev.target.value); }, ctx1]);
    renderEffect(() => {
      b1.set(0, modelExpr(ctx1['this'].text)());
    });
    return b1;
  }
}"
`;

exports[`t-model directive > in a t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, renderEffect, list } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<input type="checkbox" block-property-0="checked" block-handler-1="input"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = list(() => (ctx['this'].things), ctx, \`thing\`, (ctx1) => (ctx1['thing'].id), 15, (ctx1) => {
    const b2 = block2();
    b2.set(1, [(_ctx, ev) => { modelExpr(ctx1['thing'].f).set(ev.target.checked); }, ctx1]);
    renderEffect(() => {
      b2.set(0, modelExpr(ctx1['thing'].f)());
    });
    return b2;
  }, false);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

