"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { toNumber, text, toggle, renderEffect } = helpers;
  
  let block1 = createBlock(\`<div><input type="checkbox" block-property-0="checked" block-handler-1="input"/><span><block-child-0/></span></div>\`);
  
