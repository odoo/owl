exports[`t-model directive > t-model with radio button group in t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callHandler, modelExpr, toNumber, renderEffect, list } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].getData, ctx, ev);
  
  let block1 = createBlock(\`<div id="get_data" block-handler-0="click"><block-child-0/></div>\`);
  let block2 = createBlock(\`<input type="radio" name="radio_group" block-property-0="value" block-attribute-1="id" block-property-2="checked" block-handler-3="click"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    const c1 = list(() => (ctx['this'].options), ctx, \`opt\`, (ctx1) => (ctx1['opt']), 15, (ctx1) => {
    const b2 = block2();
    b2.set(3, [(_ctx, ev) => { modelExpr(ctx1['this'].group).set(ev.target.value); }, ctx1]);
    renderEffect(() => {
      b2.set(0, new String((ctx1['opt']) === 0 ? 0 : ((ctx1['opt']) || "")));
      b2.set(1, ctx1['opt']);
      b2.set(2, modelExpr(ctx1['this'].group)() === ctx1['opt']);
    });
    return b2;
  }, false);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

