exports[`t-model directive > two inputs in a div alternating with a t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { modelExpr, toNumber, renderEffect, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<input class="a" block-property-0="value" block-handler-1="input"/>\`);
  let block3 = createBlock(\`<input class="b" block-property-0="value" block-handler-1="input"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = toggle(() => (ctx['this'].flag()) ? 0 : -1, [() => {
    const b2 = block2();
    b2.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].text1).set(ev.target.value); }, ctx]);
    renderEffect(() => {
      b2.set(0, modelExpr(ctx['this'].text1)());
    });
    return b2;
  }]);
    b1.insert(0, c1);
    const c2 = toggle(() => (!ctx['this'].flag()) ? 0 : -1, [() => {
    const b3 = block3();
    b3.set(1, [(_ctx, ev) => { modelExpr(ctx['this'].text2).set(ev.target.value); }, ctx]);
    renderEffect(() => {
      b3.set(0, modelExpr(ctx['this'].text2)());
    });
    return b3;
  }]);
    b1.insert(1, c2);
    return b1;
  }
}"
`;

