exports[`t-on > t-on expression captured in t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, list } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['this'].otherState.vals.push(ctx['iter']+'_'+ctx['iter']);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block2 = createBlock(\`<div><button block-handler-0="click">expr</button></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`iter\`, true, () => (0));
    const c1 = list(() => (ctx1['this'].arr), ctx1, \`val\`, (ctx2) => (ctx2['val']), 15, (ctx2) => {
    const b2 = block2();
    b2.set(0, [hdlr_fn1, ctx2]);
    const ctx3 = tset(ctx2, \`iter\`, true, () => (ctx2['iter']+1));
    return b2;
  }, false);
    b1.insert(0, c1);
    return b1;
  }
}"
`;

