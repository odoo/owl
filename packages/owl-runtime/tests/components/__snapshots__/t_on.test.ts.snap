exports[`t-on > t-on on component next to t-on on div 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, catcher, callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].increment, ctx, ev);
  const hdlr_fn2 = (ctx, ev) => callHandler(ctx['this'].decrement, ctx, ev);
  
  let block1 = createBlock(\`<div><block-child-0/><p block-handler-0="click">dec</p></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = component(this, ctx, node, \`Child\`, () => ({value: ctx['this'].state.value}));
    const c2 = catcher(c1, {'click': [hdlr_fn1, ctx]});
    b1.insert(0, c2);
    b1.set(0, [hdlr_fn2, ctx]);
    return b1;
  }
}"
`;

