// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`components in t-out > simple list 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, component, tset, out, list } = helpers;
  
  return function template(ctx, node) {
    const c3 = list(() => ([1,2]), ctx, \`n\`, (ctx1) => (ctx1['n']), 15, (ctx1) => {
    const lazy1 = lazy(() => {
      const c1 = component(this, ctx1, node, \`Child\`, () => ({}));
      return c1;
    });
    const ctx2 = tset(ctx1, \`blabla\`, false, lazy1);
    const c2 = out(() => (ctx2['blabla']));
    return c2;
  }, false);
    return c3;
  }
}"
`;

exports[`components in t-out > simple list 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`child\`);
    return c1;
  }
}"
`;
