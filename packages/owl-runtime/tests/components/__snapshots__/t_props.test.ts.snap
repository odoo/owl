// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-props > basic use 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = component(this, ctx, node, \`Child\`, () => (Object.assign({}, ctx['this'].some.obj)));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-props > basic use 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.a+ctx['this'].props.b));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-props > child receives a copy of the t-props object, not the original 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  return function template(ctx, node) {
    const c1 = component(this, ctx, node, \`Child\`, () => (Object.assign({}, ctx['this'].childProps)));
    return c1;
  }
}"
`;

exports[`t-props > child receives a copy of the t-props object, not the original 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<div/>\`);
  
  return function template(ctx, node) {
