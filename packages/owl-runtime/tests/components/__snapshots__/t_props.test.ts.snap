}"
`;

exports[`t-props > t-props and other props 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  let block1 = createBlock(\`<div><div><block-child-0/></div></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = component(this, ctx, node, \`Comp\`, () => (Object.assign({}, ctx['this'].state1, {a: ctx['this'].a})));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-props > t-props and other props 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['this'].props.a));
    b1.insert(0, c1);
    const c2 = out(() => (ctx['this'].props.b));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

