exports[`t-props > t-props with props 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = component(this, ctx, node, \`Child\`, () => (Object.assign({}, ctx['this'].childProps, {a: 1, b: 2})));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

exports[`t-props > t-props with props 2`] = `
"function anonymous(app, bdom, helpers
) {
