exports[`t-set > t-set outside modified in t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, toggle, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><p><block-child-1/></p></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`iter\`, true, () => (0));
    const ctx2 = tset(ctx1, \`flag\`, true, () => (ctx1['this'].state.flag));
    const c4 = toggle(() => (ctx2['flag']==='if') ? 0 : (ctx2['flag']==='elif') ? 1 : 2, [() => {
    const ctx3 = tset(ctx2, \`iter\`, true, () => (2));
    const c1 = text("");
    return c1;
  }, () => {
    const ctx4 = tset(ctx2, \`iter\`, true, () => (3));
    const c2 = text("");
    return c2;
  }, () => {
    const ctx5 = tset(ctx2, \`iter\`, true, () => (4));
    const c3 = text("");
    return c3;
  }]);
    b1.insert(0, c4);
    const c5 = out(() => (ctx2['iter']));
    b1.insert(1, c5);
    return b1;
  }
}"
`;

exports[`t-set > t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, component, tset, out } = helpers;
  
  let block1 = createBlock(\`<div><div><block-child-0/></div></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const lazy1 = lazy(() => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({}));
    return c1;
  });
    const ctx1 = tset(ctx, \`v\`, false, lazy1);
    const c2 = out(() => (ctx1['v']));
    b1.insert(0, c2);
    return b1;
  }
}"
`;

