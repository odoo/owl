exports[`t-set > slots with an unused t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, component, tset, text, makeSlots } = helpers;
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'default': {__render: (ctx1, node) => {
    const lazy1 = lazy(() => {
      const c1 = component(this, ctx1, node, \`Child\`, () => ({}));
      return c1;
    });
    const ctx2 = tset(ctx1, \`v\`, false, lazy1);
    const c2 = text(\` in slot \`);
    return c2;
  }, __ctx: ctx}});
    const c3 = component(this, ctx, node, \`Child\`, () => ({slots: slots1}));
    return c3;
  }
}"
