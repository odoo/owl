// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-set > slot setted value (with t-set) not accessible with t-out 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, out, text, makeSlots, component } = helpers;
  
  let block1 = createBlock(\`<div><p><block-child-0/></p><block-child-1/><p><block-child-2/></p></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`iter\`, true, () => ('source'));
    const c1 = out(() => (ctx1['iter']));
    b1.insert(0, c1);
    const slots1 = makeSlots({'default': {__render: (ctx2, node) => {
    const ctx3 = tset(ctx2, \`iter\`, true, () => ('inCall'));
    const c2 = text("");
    return c2;
  }, __ctx: ctx1}});
    const c3 = component(this, ctx1, node, \`Childcomp\`, () => ({slots: slots1}));
    b1.insert(1, c3);
    const c4 = out(() => (ctx1['iter']));
    b1.insert(2, c4);
    return b1;
  }
}"
`;

exports[`t-set > slot setted value (with t-set) not accessible with t-out 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { out, tset } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c1 = out(() => (ctx['iter']));
    b1.insert(0, c1);
    const ctx1 = tset(ctx, \`iter\`, true, () => ('called'));
    const c2 = out(() => (ctx1['iter']));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

exports[`t-set > slots with a t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, component, tset, text, out, multi, makeSlots } = helpers;
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'default': {__render: (ctx1, node) => {
    const lazy1 = lazy(() => {
      const c1 = component(this, ctx1, node, \`C\`, () => ({}));
      return c1;
    });
    const ctx2 = tset(ctx1, \`v\`, false, lazy1);
    const c2 = text(\` in slot \`);
    const c3 = out(() => (ctx2['v']));
    const c4 = multi([c2, c3]);
    return c4;
  }, __ctx: ctx}});
    const c5 = component(this, ctx, node, \`Child\`, () => ({slots: slots1}));
    return c5;
  }
}"
`;

exports[`t-set > slots with a t-set with a component in body 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { text, callSlot, multi } = helpers;
  
  return function template(ctx, node) {
    const c1 = text(\`Child \`);
    const c2 = callSlot(ctx, node, 'default', null, null, null);
    const c3 = multi([c1, c2]);
    return c3;
  }
}"
`;

