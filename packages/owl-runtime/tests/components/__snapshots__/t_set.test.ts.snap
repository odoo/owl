exports[`t-set > slots with an t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, component, multi, tset, text, out, makeSlots } = helpers;
  
  let block1 = createBlock(\`<div>coffee</div>\`);
  
  return function template(ctx, node) {
    const slots1 = makeSlots({'default': {__render: (ctx1, node) => {
    const lazy1 = lazy(() => {
      const c1 = component(this, ctx1, node, \`Child\`, () => ({}));
      const b1 = block1();
      const c2 = multi([c1, b1]);
      return c2;
    });
    const ctx2 = tset(ctx1, \`v\`, false, lazy1);
    const c3 = text(\` tea \`);
    const c4 = out(() => (ctx2['v']));
    const c5 = multi([c3, c4]);
    return c5;
  }, __ctx: ctx}});
    const c6 = component(this, ctx, node, \`Blorg\`, () => ({slots: slots1}));
    return c6;
  }
}"
`;

