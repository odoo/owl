exports[`t-set > t-set with something in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { lazy, tset, out } = helpers;
  
  let block1 = createBlock(\`<div><div><block-child-0/></div></div>\`);
  let block2 = createBlock(\`<p>coucou</p>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const lazy1 = lazy(() => {
    const b2 = block2();
    return b2;
  });
    const ctx1 = tset(ctx, \`v\`, false, lazy1);
    const c1 = out(() => (ctx1['v']));
    b1.insert(0, c1);
    return b1;
  }
}"
`;
