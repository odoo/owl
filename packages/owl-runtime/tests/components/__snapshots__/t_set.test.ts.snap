}"
`;

exports[`t-set > t-set in t-if 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, text, toggle, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><p><block-child-1/></p></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`flag\`, true, () => (ctx['this'].state.flag));
    const c4 = toggle(() => (ctx1['flag']==='if') ? 0 : (ctx1['flag']==='elif') ? 1 : 2, [() => {
    const ctx2 = tset(ctx1, \`iter\`, true, () => (2));
    const c1 = text("");
    return c1;
  }, () => {
    const ctx3 = tset(ctx1, \`iter\`, true, () => (3));
    const c2 = text("");
    return c2;
  }, () => {
    const ctx4 = tset(ctx1, \`iter\`, true, () => (4));
    const c3 = text("");
    return c3;
  }]);
    b1.insert(0, c4);
    const c5 = out(() => (ctx1['iter']));
    b1.insert(1, c5);
    return b1;
  }
}"
`;

