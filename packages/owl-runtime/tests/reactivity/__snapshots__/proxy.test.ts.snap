// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Reactivity: proxy > destroyed component before being mounted is inactive 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { component, toggle } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const c2 = toggle(() => (ctx['this'].state.flag) ? 0 : -1, [() => {
    const c1 = component(this, ctx, node, \`Child\`, () => ({}));
    return c1;
  }]);
    b1.insert(0, c2);
    return b1;
  }
}"
`;

exports[`Reactivity: proxy > destroyed component before being mounted is inactive 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, out } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/></span>\`);
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`noop\`, true, () => (ctx['this'].notify()));
    const b1 = block1();
    const c1 = out(() => (ctx1['this'].contextObj.a));
    b1.insert(0, c1);
    return b1;
  }
}"
`;

