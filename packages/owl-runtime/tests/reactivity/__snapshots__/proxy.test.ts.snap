exports[`Reactivity: proxy > useless atoms should be deleted 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, component, list, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/> Total: <block-child-1/> Count: <block-child-2/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`noop\`, true, () => (ctx['this'].notify()));
    const c2 = list(() => (Object.keys(ctx1['this'].state)), ctx1, \`id\`, (ctx2) => (ctx2['id']), 15, (ctx2) => {
    const c1 = component(this, ctx2, node, \`Quantity\`, () => ({id: ctx2['id']}));
    return c1;
  }, false);
    b1.insert(0, c2);
    const c3 = out(() => (ctx1['this'].total));
    b1.insert(1, c3);
    const c4 = out(() => (Object.keys(ctx1['this'].state).length));
    b1.insert(2, c4);
    return b1;
  }
}"
`;

