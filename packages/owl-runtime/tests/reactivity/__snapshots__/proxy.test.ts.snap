exports[`Reactivity: proxy > one components can subscribe twice to same context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    const ctx1 = tset(ctx, \`noop\`, true, () => (ctx['this'].notify()));
    const c1 = out(() => (ctx1['this'].contextObj1.a));
    b1.insert(0, c1);
    const c2 = out(() => (ctx1['this'].contextObj2.b));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

exports[`Reactivity: proxy > parent and children subscribed to same context 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { tset, component, out } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node) {
    const ctx1 = tset(ctx, \`noop\`, true, () => (ctx['this'].notify()));
    const b1 = block1();
    const c1 = component(this, ctx1, node, \`Child\`, () => ({}));
    b1.insert(0, c1);
    const c2 = out(() => (ctx1['this'].contextObj.b));
    b1.insert(1, c2);
    return b1;
  }
}"
`;

