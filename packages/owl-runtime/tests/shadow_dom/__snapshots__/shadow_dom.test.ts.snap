exports[`shadow_dom > ref 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { createRef } = helpers;
  
  let block1 = createBlock(\`<div class="my-div" block-ref="0"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.ref(0, createRef(ctx['this'].div, node));
    return b1;
  }
}"
`;
