// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shadow_dom > can bind event handler 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  let { callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].add, ctx, ev);
  
  let block1 = createBlock(\`<button block-handler-0="click">Click</button>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    b1.set(0, [hdlr_fn1, ctx]);
    return b1;
  }
}"
`;

exports[`shadow_dom > can mount app 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { createBlock } = bdom;
  
  let block1 = createBlock(\`<div class="my-div"/>\`);
  
  return function template(ctx, node) {
    const b1 = block1();
    return b1;
  }
}"
`;

